# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to git.

# Get these from https://groww.in/trade-api/api-keys
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here

# Get this from https://www.marketaux.com/register (free tier: 100 requests/day)
MARKETAUX_API_TOKEN=your_marketaux_api_token_here

# Optional: only needed if you want an LLM to add plain-English
# narration on top of Marketaux's sentiment scores (not required for
# the pipeline to function — Marketaux already scores sentiment).
LLM_API_KEY=your_llm_api_key_here
